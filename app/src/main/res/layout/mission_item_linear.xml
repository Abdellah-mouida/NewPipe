<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/item_bkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="@color/bluegray">

        <ImageView
            android:id="@+id/item_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_centerVertical="true"
            android:contentDescription="TODO"
            android:gravity="center"
            android:padding="15dp"
            android:scaleType="fitXY"
            app:tint="?attr/actionColor" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/item_more"
            android:layout_toRightOf="@id/item_icon"
            android:ellipsize="end"
            android:padding="6dp"
            android:text="XXX.xx"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/item_name"
            android:layout_toRightOf="@id/item_icon"
            android:padding="6dp"
            android:singleLine="true"
            android:text="100.00MB"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/item_name"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="5dp"
            android:layout_toLeftOf="@+id/item_more"
            android:layout_toRightOf="@id/item_size"
            android:padding="6dp"
            android:singleLine="true"
            android:text="0%"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_name"
            android:layout_toLeftOf="@id/item_more"
            android:padding="6dp"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/white"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/item_more"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="49dp"
            android:layout_height="49dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="4dp"
            android:contentDescription="TODO"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/actionColor" />


        <TextView
            android:id="@+id/item_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_size"
            android:layout_toEndOf="@id/item_icon"
            android:layout_toStartOf="@id/item_more"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/download_mission_card"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <View
            android:id="@+id/item_progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_below="@id/item_state"
            android:layout_toEndOf="@id/item_icon"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="60dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/download_progress_track" />
    </RelativeLayout>

</RelativeLayout>
