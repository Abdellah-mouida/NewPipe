<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <RelativeLayout
        android:id="@+id/item_bkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        android:background="@drawable/download_mission_card"
        android:minHeight="112dp"
        android:paddingEnd="4dp">
        <ImageView
            android:id="@+id/item_icon"
            android:layout_width="96dp"
            android:layout_height="112dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/metadata_thumbnails"
            android:scaleType="centerCrop" />
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/item_more"
            android:layout_toEndOf="@id/item_icon"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="9dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:text="XXX.xx"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_name"
            android:layout_toEndOf="@id/item_icon"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:text="100.00MB"
            android:textColor="#DFFFFFFF"
            android:textSize="12sp" />
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_name"
            android:layout_marginStart="7dp"
            android:layout_toEndOf="@id/item_size"
            android:paddingTop="3dp"
            android:singleLine="true"
            android:text="0%"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_name"
            android:layout_alignParentEnd="true"
            android:padding="6dp"
            android:singleLine="true"
            android:text=""
            android:textColor="#DFFFFFFF"
            android:textSize="11sp" />
        <ImageView
            android:id="@+id/item_more"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="1dp"
            android:contentDescription="@string/more_options"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/white" />
        <TextView
            android:id="@+id/item_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_size"
            android:layout_toEndOf="@id/item_icon"
            android:layout_marginStart="9dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/download_mission_card"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </RelativeLayout>
    <View
        android:id="@+id/item_progress"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="9dp"
        android:background="@drawable/download_progress_track" />
</LinearLayout>
