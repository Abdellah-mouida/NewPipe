<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="?attr/npColorBackground" />
    </item>
    <!-- A restrained blue corner wash; two-stop linear gradients keep API 27 safe. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#1A246BFD"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
