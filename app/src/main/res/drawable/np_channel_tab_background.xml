<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="?attr/npColorAccentGradientStart"
                android:endColor="?attr/npColorAccentGradientMid" />
            <corners android:radius="@dimen/np_radius_lg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/np_radius_lg" />
        </shape>
    </item>
</selector>
