<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="?attr/npColorBackground" />
    </item>
    <!-- Use two-stop linear gradients for reliable rendering on Android 8.1. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="?attr/npColorAccentContainer"
                android:endColor="#001A5B3D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1022A6F2"
                android:endColor="?attr/npColorAccentContainer" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00000000"
                android:endColor="#22080D1B" />
        </shape>
    </item>
</layer-list>
